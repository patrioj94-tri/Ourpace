# ---- Supabase (Project Settings -> API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only. never expose this one.

# ---- The app's own address --------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Strava (https://www.strava.com/settings/api) ---------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=          # any random string you invent

# ---- Google (Cloud console -> OAuth client, Calendar API enabled) -----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Claude, for the Sunday note (optional) ---------------------------------
ANTHROPIC_API_KEY=

# ---- Protects the scheduled jobs from strangers -----------------------------
CRON_SECRET=
